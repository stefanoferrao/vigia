        try:
            os.unlink(AUTOSTART_PATH)
        except FileNotFoundError:
            pass
        except OSError as error:
            log(f"autostart remove failed: {error}")


# --------------------------------------------------------------- system metrics

class SystemMetrics:
    def __init__(self):
        self._last_cpu = self._cpu_sample()

    @staticmethod
    def _cpu_sample():
        try:
            with open("/proc/stat", encoding="ascii") as handle:
                fields = handle.readline().split()[1:]
            values = [int(value) for value in fields]
        except (OSError, ValueError, IndexError):
            return None
        idle = values[3] + (values[4] if len(values) > 4 else 0)
        return (sum(values), idle)

    def cpu(self):
        sample = self._cpu_sample()
        if not sample or not self._last_cpu:
            self._last_cpu = sample
            return None
        total = sample[0] - self._last_cpu[0]
        idle = sample[1] - self._last_cpu[1]
        self._last_cpu = sample
        if total <= 0:
            return None
        return max(0, min(100, round((total - idle) * 100 / total)))

    @staticmethod
    def ram():
        try:
            values = {}
            with open("/proc/meminfo", encoding="ascii") as handle:
                for line in handle:
                    key, _, rest = line.partition(":")
                    values[key] = int(rest.split()[0])
            total = values.get("MemTotal", 0)
            available = values.get("MemAvailable", values.get("MemFree", 0))
        except (OSError, ValueError, IndexError):
            return None
        if total <= 0:
            return None
        return max(0, min(100, round((total - available) * 100 / total)))

    @staticmethod
    def gpu():
        for path in sorted(glob.glob("/sys/class/drm/card*/device/gpu_busy_percent")):
            try:
                with open(path, encoding="ascii") as handle:
                    return max(0, min(100, int(handle.read().strip())))
            except (OSError, ValueError):
                continue
        return None

    def snapshot(self):
        return [("CPU", self.cpu()), ("RAM", self.ram()), ("GPU", self.gpu())]


# --------------------------------------------------------------------- icon tint

_icon_cache = {}


def provider_pixbuf(brand, tint, size):
    filename = ICON_FILES.get(brand)
    if not filename:
        return None
    key = (filename, tint, size)
    if key in _icon_cache:
        return _icon_cache[key]
    svg = None
    for directory in icon_directories():
        path = os.path.join(directory, filename)
        try:
            with open(path, "rb") as handle:
                svg = handle.read()
            break
        except OSError:
            continue
    if svg is None:
        return None
    svg = svg.replace(b"#ffffff", tint.encode()).replace(b"currentColor", tint.encode())
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(svg)
        loader.close()
        pixbuf = loader.get_pixbuf()
    except GLib.Error:
        return None
    _icon_cache[key] = pixbuf
    return pixbuf


def icon_tint(brand, style):
    if style == "mono":
        return MONO_ICON_TINT
    if style == "alert":
        return MONO_ICON_TINT
    return BRAND_COLORS.get(brand, DEFAULT_ICON_TINT)


def value_tint(style, percent):
    if style != "alert" or not isinstance(percent, (int, float)):
        return TEXT_PRIMARY
    if percent >= 80:
        return "#ed4b48"
    if percent >= 60:
        return "#f2bd34"
    return TEXT_PRIMARY


