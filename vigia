        menu.append(Gtk.SeparatorMenuItem())

        refresh = Gtk.MenuItem(label=self.t("refresh_now"))
        refresh.connect("activate", lambda *_: self.trigger_refresh())
        menu.append(refresh)

        config_item = Gtk.MenuItem(label=self.t("open_config"))
        config_item.connect("activate", lambda *_: self.open_config())
        menu.append(config_item)

        reset = Gtk.MenuItem(label=self.t("reset_position"))
        reset.connect("activate", lambda *_: self.reset_position())
        menu.append(reset)

        hide = Gtk.MenuItem(label=self.t("hide"))
        hide.connect("activate", lambda *_: self.hide_all())
        menu.append(hide)

        quit_item = Gtk.MenuItem(label=self.t("quit"))
        quit_item.connect("activate", lambda *_: Gtk.main_quit())
        menu.append(quit_item)

        menu.show_all()
        self.menu = menu
        if event is not None:
            menu.popup_at_pointer(event)
        else:
            menu.popup_at_widget(widget, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)

    def metrics_size(self):
        return SIZES[self.config.get("size")]

    def language(self):
        choice = self.config.get("language")
        return choice if choice in STRINGS else system_language()

    def t(self, key, **kwargs):
        lang = self.language()
        text = STRINGS.get(lang, STRINGS["en"]).get(key) or STRINGS["en"].get(key, key)
        return text.format(**kwargs) if kwargs else text

    def on_language(self, item, key):
        if not item.get_active():
            return
        self.config.set("language", key)
        for window in self.windows:
            window.render(self.data)

    def on_opacity(self, item, step):
        if not item.get_active():
            return
        self.config.set("opacity", step / 100.0)
        for window in self.windows:
            window.queue_draw()

    def on_size(self, item, key):
        if not item.get_active():
            return
        self.config.set("size", key)
        for window in self.windows:
            window.apply_style()
            window.render(self.data)

    def on_icon_style(self, item, key):
        if not item.get_active():
            return
        self.config.set("icon_style", key)
        for window in self.windows:
            window.render(self.data)

    def on_monitor(self, item, key):
        if not item.get_active():
            return
        self.config.set("monitor", key)
        self.rebuild()

    def on_anchor(self, item, key):
        if not item.get_active():
            return
        self.config.set("anchor", key)
        # A dragged position wins over the anchor, so switching the anchor has
        # to drop the stored offsets for every monitor.
        self.config.positions = {}
        self.config.save()
        for window in self.windows:
            window.place(force=True)

    def on_always_on_top(self, item):
        value = item.get_active()
        self.config.set("always_on_top", value)
        for window in self.windows:
            window.set_keep_above(value)

    def on_show_system(self, item):
        value = item.get_active()
        self.config.set("show_system", value)
        for window in self.windows:
            window.render(self.data)

    def on_autostart(self, item):
        value = item.get_active()
        self.config.set("autostart", value)
        set_autostart(value)

    def open_config(self):
        try:
            Gtk.show_uri(None, f"file://{CONFIG_PATH}", Gdk.CURRENT_TIME)
        except GLib.Error as error:
            log(f"open config failed: {error}")

    def reset_position(self):
        self.config.positions = {}
        self.config.save()
        for window in self.windows:
            window.place(force=True)

    # -- visibility ---------------------------------------------------------
    def hide_all(self):
        self.hidden = True
        for window in self.windows:
            window.hide()

    def show_all(self):
        self.hidden = False
        for window in self.windows:
            window.show_all()
            if not window.hovered:
                window.gear.set_opacity(0)

    def toggle(self):
        if self.hidden:
            self.show_all()
        else:
            self.hide_all()


# ----------------------------------------------------------------------------- ipc

def send_command(command):
    for _ in range(20):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                client.settimeout(0.5)
                client.connect(SOCKET_PATH)
                client.sendall(command.encode("ascii"))
            return True
        except (OSError, socket.timeout):
            time.sleep(0.1)
    return False


def on_ipc(fd, condition, server, app):
    try:
        connection, _ = server.accept()
        with connection:
            command = connection.recv(32)
        if command == b"TOGGLE":
            app.toggle()
        elif command == b"SHOW":
            app.show_all()
        elif command == b"HIDE":
            app.hide_all()
        elif command == b"REFRESH":
            app.trigger_refresh()
        elif command == b"RELOAD":
            app.reload_config()
        elif command == b"QUIT":
            Gtk.main_quit()
    except OSError as error:
        log(f"ipc error: {error}")
    return True


# ---------------------------------------------------------------------------- main

def main():
    if "--version" in sys.argv or "-v" in sys.argv:
        print(f"{APP_NAME} {VERSION}")
        return
    if "--help" in sys.argv or "-h" in sys.argv:
        print(f"{APP_NAME} {VERSION} — AI usage and system metrics at a glance\n"
              "\n"
              "  vigia              run the pill (starts it if needed)\n"
              "  vigia --show       show it, starting the process if needed\n"
              "  vigia --toggle     show/hide (bind this to a shortcut)\n"
              "  vigia --reload     re-read ~/.config/vigia/vigia.toml\n"
              "  vigia --quit       stop the running instance\n"
              "  vigia --version    print the version\n")
        return
    if "--toggle" in sys.argv:
        if send_command("TOGGLE"):
            return
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__)],
            start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return
    if "--show" in sys.argv and send_command("SHOW"):
        return
    if "--reload" in sys.argv and send_command("RELOAD"):
        return
    if "--quit" in sys.argv and send_command("QUIT"):
        return

    Gdk.set_program_class(APP_NAME)
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    os.makedirs(RUNTIME_DIR, exist_ok=True)
    lock_fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        import fcntl
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, ImportError):
        print("vigia is already running", file=sys.stderr)
        return

    try:
        os.unlink(SOCKET_PATH)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET_PATH)
    os.chmod(SOCKET_PATH, 0o600)
    server.listen(4)
    server.setblocking(False)

    try:
        app = OverlayApp()
    except Exception as error:  # keep a trace for a window that never appeared
        log(f"startup failed: {error!r}")
        raise
    GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_ipc, server, app)
    try:
        Gtk.main()
    finally:
        if app.hotkey and Keybinder is not None:
            Keybinder.unbind(app.hotkey)
        server.close()
        try:
            os.unlink(SOCKET_PATH)
        except FileNotFoundError:
            pass
        os.close(lock_fd)


if __name__ == "__main__":
    main()
