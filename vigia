class PillWindow(Gtk.Window):
    def __init__(self, app, monitor_index):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.app = app
        self.monitor_index = monitor_index
        self.hovered = False
        self.system_labels = {}
        self._drag = None

        self.set_title(APP_NAME)
        self.set_icon_name("vigia")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_keep_above(app.config.get("always_on_top"))
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)

        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.connect("draw", self.on_draw)
        self.connect("enter-notify-event", self.on_enter)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-release-event", self.on_release)
        self.connect("map-event", lambda *_: GLib.idle_add(self.place))
        self.connect("size-allocate", self.on_size_allocate)

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(self.box)
        self.apply_style()
        self.render(None)
        self.show_all()
        self.gear.set_opacity(0)
        GLib.idle_add(self.initial_place)

    # -- look ---------------------------------------------------------------
    def metrics(self):
        return SIZES[self.app.config.get("size")]

    def apply_style(self):
        size = self.metrics()
        self.css.load_from_data(
            f"""
            window {{ background-color: transparent; }}
            .pill-row {{ background: transparent; }}
            .pill-label {{
                color: {TEXT_MUTED};
                font-size: {size['font']:.1f}px;
            }}
            .pill-value {{
                color: {TEXT_PRIMARY};
                font-size: {size['font']:.1f}px;
                font-weight: 700;
            }}
            .pill-divider {{
                background-color: rgba(255,255,255,0.16);
                min-width: 1px;
            }}
            .pill-gear {{
                color: #a8afba;
            }}
            """.encode()
        )
        self.queue_draw()

    def on_draw(self, widget, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()
        radius = height / 2.0
        alpha = self.app.effective_alpha(boost=self.hovered)
        cr.set_source_rgba(0.078, 0.078, 0.094, alpha)
        self._round_rect(cr, 0.5, 0.5, width - 1, height - 1, radius)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 0.09)
        cr.set_line_width(1)
        self._round_rect(cr, 0.5, 0.5, width - 1, height - 1, radius)
        cr.stroke()
        return False

    @staticmethod
    def _round_rect(cr, x, y, width, height, radius):
        import math
        radius = min(radius, width / 2, height / 2)
        cr.new_sub_path()
        cr.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
        cr.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
        cr.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
        cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()

    # -- content ------------------------------------------------------------
    def render(self, data):
        for child in self.box.get_children():
            self.box.remove(child)
        self._value_labels = []
        size = self.metrics()
        self.box.set_border_width(0)
        self.box.set_margin_start(size["pad_h"])
        self.box.set_margin_end(size["pad_h"] - 2)
        self.box.set_margin_top(size["pad_v"])
        self.box.set_margin_bottom(size["pad_v"])
        self.box.set_spacing(size["gap"])

        style = self.app.config.get("icon_style")
        providers = []
        for entry in dashboard_entries(data):
            metric = summary_metric(entry)
            if metric is None:
                continue
            providers.append((entry, metric))
            if len(providers) >= self.app.config.get("max_providers"):
                break

        if not providers:
            label = Gtk.Label(label="—")
            label.get_style_context().add_class("pill-label")
            self.box.pack_start(label, False, False, 0)
        for entry, metric in providers:
            brand = str(entry.get("brand") or entry.get("id") or "").split("@", 1)[0]
            pair = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
            pair.get_style_context().add_class("pill-row")
            pixbuf = provider_pixbuf(brand, icon_tint(brand, style), size["icon"])
            if pixbuf is not None:
                image = Gtk.Image.new_from_pixbuf(pixbuf)
                image.set_size_request(size["icon"], size["icon"])
                pair.pack_start(image, False, False, 0)
            value = Gtk.Label(label=metric_display(metric))
            value.set_max_width_chars(6)
            value.set_ellipsize(Pango.EllipsizeMode.END)
            value.set_xalign(1.0)
            value.get_style_context().add_class("pill-value")
            self._value_labels.append(value)
            percent = metric.get("percent")
            tint = value_tint(style, percent)
            if tint != TEXT_PRIMARY:
                rgba = Gdk.RGBA()
                rgba.parse(tint)
                value.override_color(Gtk.StateFlags.NORMAL, rgba)
            pair.pack_start(value, False, False, 0)
            tooltip = str(entry.get("display_name") or entry.get("name") or brand)
            tip_label = metric.get("label")
            if tip_label:
                tooltip = f"{tooltip} — {tip_label}"
            pair.set_tooltip_text(f"{tooltip}: {value.get_text()}")
            self.box.pack_start(pair, False, False, 0)

        self.system_labels = {}
        if self.app.config.get("show_system"):
            divider = Gtk.Box()
            divider.get_style_context().add_class("pill-divider")
            divider.set_size_request(1, size["icon"] - 2)
            self.box.pack_start(divider, False, False, 0)
            for name, reading in self.app.metrics.snapshot():
                if reading is None:
                    continue
                pair = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
                label = Gtk.Label(label=name)
                label.get_style_context().add_class("pill-label")
                value = Gtk.Label(label=f"{reading}%")
                value.set_max_width_chars(4)
                value.set_xalign(1.0)
                value.get_style_context().add_class("pill-value")
                self._value_labels.append(value)
                pair.pack_start(label, False, False, 0)
                pair.pack_start(value, False, False, 0)
                self.box.pack_start(pair, False, False, 0)
                self.system_labels[name] = value

        self.gear = Gtk.EventBox()
        self.gear.set_visible_window(False)
        self.gear.get_style_context().add_class("pill-gear")
        icon = Gtk.Image.new_from_icon_name("preferences-system-symbolic", Gtk.IconSize.MENU)
        icon.set_pixel_size(max(9, size["icon"] - 2))
        self.gear.add(icon)
        self.gear.set_tooltip_text(self.app.t("gear"))
        self.gear.connect("button-press-event", self.on_gear)
        self.gear.set_opacity(1 if self.hovered else 0)
        self.box.pack_start(self.gear, False, False, 0)
        self.show_all()
        if not self.hovered:
            self.gear.set_opacity(0)
        self.queue_resize()
        GLib.idle_add(self.fix_value_widths)
        GLib.idle_add(self.place)
        if os.environ.get("AI_USAGEBAR_DEBUG"):
            GLib.idle_add(self._debug_dump)

    def fix_value_widths(self):
        """Reserve the exact pixel width of "100%" for every number.

        width_chars measures average characters, so a value crossing a digit
        boundary still nudged the pill by a few pixels.
        """
        labels = getattr(self, "_value_labels", [])
        if not labels:
            return False
        width = 0
        for label in labels:
            layout = label.create_pango_layout("100%")
            width = max(width, layout.get_pixel_size()[0])
        for label in labels:
            if label.get_size_request()[0] != width:
                label.set_size_request(width, -1)
        return False

    def _debug_dump(self):
        log(f"window size={self.get_size()} box={self.box.get_allocated_width()}x{self.box.get_allocated_height()}")
        for child in self.box.get_children():
            kind = type(child).__name__
            if isinstance(child, Gtk.Box):
                inner = []
                for sub in child.get_children():
                    text = getattr(sub, "get_text", lambda: "")()
                    inner.append(f"{type(sub).__name__}:{text!r}:{sub.get_allocated_width()}x{sub.get_allocated_height()}")
                log(f"  box {child.get_allocated_width()}x{child.get_allocated_height()} -> {inner}")
            else:
                log(f"  {kind} {child.get_allocated_width()}x{child.get_allocated_height()}")
        return False

    def update_system(self):
        if not self.system_labels:
            return
        for name, reading in self.app.metrics.snapshot():
            label = self.system_labels.get(name)
            if label is not None and reading is not None:
                label.set_text(f"{reading}%")

    # -- interaction --------------------------------------------------------
    def set_hover(self, hovered):
        if self.hovered == hovered:
            return
        self.hovered = hovered
        if hasattr(self, "gear"):
            self.gear.set_opacity(1 if hovered else 0)
        self.queue_draw()

    def on_enter(self, widget, event):
        if event.detail != Gdk.NotifyType.INFERIOR:
            self.set_hover(True)
        return False

    def on_leave(self, widget, event):
        if event.detail != Gdk.NotifyType.INFERIOR:
            self.set_hover(False)
        return False

    def on_press(self, widget, event):
        if event.button == 1 and event.window == self.get_window():
            self._drag = (event.x_root, event.y_root, *self.get_position())
            return True
        if event.button == 3:
            self.app.popup_menu(widget, event)
            return True
        return False

    def on_motion(self, widget, event):
        if self._drag is None:
            return False
        start_x, start_y, win_x, win_y = self._drag
        self.move(int(win_x + event.x_root - start_x), int(win_y + event.y_root - start_y))
        return True

    def on_release(self, widget, event):
        if self._drag is None:
            return False
        self._drag = None
        self.app.remember_position(self)
        return True

    def on_gear(self, widget, event):
        self.app.popup_menu(widget, event)
        return True

    def on_size_allocate(self, widget, allocation):
        # The right edge is the anchor, so growth must move the window left.
        # Using the new allocation (not get_size()) keeps it inside this monitor
        # even when the neighbour screen starts right at the seam. Stored
        # positions are re-clamped too, otherwise a size change spills over.
        if self._drag is None:
            self.anchor(allocation.width, allocation.height)
        return False

    # -- placement ----------------------------------------------------------
    def initial_place(self):
        return self.place()

    def place(self, force=False):
        return self.anchor(self.get_allocated_width(), self.get_allocated_height(), force)

    def clamped(self, x, y, width, height):
        """Keep the pill inside its own monitor.

        Edges shared with another monitor get the same margin the default
        anchor uses, so the pill never looks glued to (or spills over) the
        seam. Outer edges may sit flush.
        """
        area = self.app.workarea(self.monitor_index)
        left, right, top, bottom = self.app.seam_edges(self.monitor_index)
        min_x = area.x + (MARGIN if left else 0)
        max_x = area.x + area.width - width - (MARGIN if right else 0)
        if max_x < min_x:
            min_x, max_x = area.x, area.x + area.width - width
        min_y = area.y + (MARGIN if top else 0)
        max_y = area.y + area.height - height - (MARGIN if bottom else 0)
        if max_y < min_y:
            min_y, max_y = area.y, area.y + area.height - height
        return max(min_x, min(x, max_x)), max(min_y, min(y, max_y))

    def anchor(self, width, height, force=False):
        area = self.app.workarea(self.monitor_index)
        if area is None:
            return False
        stored = None if force else self.app.config.positions.get(str(self.monitor_index))
        if stored:
            x, y = area.x + stored[0], area.y + stored[1]
        else:
            x, y = self.app.anchored_position(area, width, height)
        x, y = self.clamped(x, y, width, height)
        if os.environ.get("AI_USAGEBAR_DEBUG"):
            log(f"anchor m{self.monitor_index} area=({area.x},{area.y},{area.width},{area.height}) "
                f"size={width}x{height} -> ({int(x)},{int(y)})")
        if self.get_position() != (int(x), int(y)):
            self.move(int(x), int(y))
        return False


# ---------------------------------------------------------------------------- app

class OverlayApp:
    def __init__(self):
        self.config = Config()
        self.metrics = SystemMetrics()
        self.data = None
        self.windows = []
        self.menu = None
        self.hidden = False
        self.refreshing = False
        self.hotkey = None
        self.bind_hotkey()
        self.build_windows()
        self.trigger_refresh()
        GLib.timeout_add_seconds(2, self.system_tick)
        GLib.timeout_add_seconds(60, self.minute_tick)
        set_autostart(self.config.get("autostart"))
        self._last_provider_fetch = time.monotonic()

    # -- hotkey -------------------------------------------------------------
    def bind_hotkey(self):
        if Keybinder is None:
            log("Keybinder unavailable; global shortcut disabled")
            return
        Keybinder.init()
        accelerator = self.config.get("hotkey")
        try:
            bound = Keybinder.bind(accelerator, self.on_hotkey)
        except GLib.Error as error:
            log(f"hotkey bind failed: {error}")
            return
        if bound:
            self.hotkey = accelerator
            log(f"hotkey bound: {accelerator}")
        else:
            log(f"hotkey refused (already taken): {accelerator}")

    def on_hotkey(self, accelerator, *args):
        self.toggle()
        return True

    # -- monitors -----------------------------------------------------------
    def display(self):
        return Gdk.Display.get_default()

    def monitors(self):
        display = self.display()
        return [display.get_monitor(index) for index in range(display.get_n_monitors())]

    def primary_index(self):
        display = self.display()
        primary = display.get_primary_monitor()
        for index, monitor in enumerate(self.monitors()):
            if monitor is primary:
                return index
        return 0

    def monitor_indices(self):
        count = len(self.monitors())
        choice = self.config.get("monitor")
        if choice == "all":
            return list(range(count))
        if choice == "secondary":
            primary = self.primary_index()
            secondary = [index for index in range(count) if index != primary]
            return secondary[:1] or [primary]
        if choice.isdigit():
            return [int(choice)] if int(choice) < count else [0]
        return [self.primary_index()]

    def monitor_for(self, index):
        monitors = self.monitors()
        if index < len(monitors):
            return monitors[index]
        return monitors[0] if monitors else None

    def workarea(self, index):
        monitor = self.monitor_for(index)
        return monitor.get_workarea() if monitor is not None else None

    def anchored_position(self, area, width, height):
        vertical, horizontal = self.config.get("anchor").split("-", 1)
        x = {
            "left": area.x + MARGIN,
            "center": area.x + (area.width - width) // 2,
            "right": area.x + area.width - width - MARGIN,
        }[horizontal]
        y = {
            "top": area.y + MARGIN,
            "middle": area.y + (area.height - height) // 2,
            "bottom": area.y + area.height - height - MARGIN,
        }[vertical]
        return x, y

    def seam_edges(self, index):
        """Which sides of this monitor touch another monitor."""
        monitors = self.monitors()
        if index >= len(monitors):
            return (False, False, False, False)
        geometry = monitors[index].get_geometry()
        left = right = top = bottom = False
        for other_index, other in enumerate(monitors):
            if other_index == index:
                continue
            edge = other.get_geometry()
            overlaps_y = not (edge.y + edge.height <= geometry.y
                              or edge.y >= geometry.y + geometry.height)
            overlaps_x = not (edge.x + edge.width <= geometry.x
                              or edge.x >= geometry.x + geometry.width)
            if overlaps_y and edge.x + edge.width == geometry.x:
                left = True
            if overlaps_y and edge.x == geometry.x + geometry.width:
                right = True
            if overlaps_x and edge.y + edge.height == geometry.y:
                top = True
            if overlaps_x and edge.y == geometry.y + geometry.height:
                bottom = True
        return (left, right, top, bottom)

    def build_windows(self):
        for window in self.windows:
            window.destroy()
        self.windows = []
        for index in self.monitor_indices():
            window = PillWindow(self, index)
            if self.data:
                window.render(self.data)
            self.windows.append(window)
        if self.hidden:
            for window in self.windows:
                window.hide()

    def rebuild(self):
        self.build_windows()

    def reload_config(self):
        """Apply overlay.toml edits without restarting the process."""
        previous_hotkey = self.hotkey
        self.config.load()
        if self.config.get("hotkey") != previous_hotkey:
            if previous_hotkey and Keybinder is not None:
                Keybinder.unbind(previous_hotkey)
            self.hotkey = None
            self.bind_hotkey()
        set_autostart(self.config.get("autostart"))
        self.build_windows()

    def remember_position(self, window):
        index = window.monitor_index
        area = self.workarea(index)
        width, height = window.get_size()
        x, y = window.clamped(*window.get_position(), width, height)
        if (x, y) != window.get_position():
            window.move(int(x), int(y))
        self.config.positions[str(index)] = (x - area.x, y - area.y)
        self.config.save()

    def monitor_index_of(self, monitor):
        for index, candidate in enumerate(self.monitors()):
            if candidate is monitor:
                return index
        return 0

    # -- alpha --------------------------------------------------------------
    def effective_alpha(self, boost=False):
        alpha = self.config.get("opacity")
        return min(1.0, alpha + (0.10 if boost else 0.0))

    # -- data ---------------------------------------------------------------
    def trigger_refresh(self):
        if self.refreshing:
            return
        self.refreshing = True
        threading.Thread(target=self._fetch, daemon=True).start()

    def _fetch(self):
        try:
            result = subprocess.run(
                [AI_USAGEBAR_BIN, "usage", "--json"],
                capture_output=True, text=True, timeout=25,
            )
            if result.returncode == 0 and result.stdout.strip():
                GLib.idle_add(self._apply, json.loads(result.stdout))
            else:
                log(f"usage failed rc={result.returncode}: {result.stderr.strip()[:200]}")
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
            log(f"usage error: {error}")
        finally:
            GLib.idle_add(self._done)

    def _apply(self, data):
        self.data = data
        self._last_provider_fetch = time.monotonic()
        for window in self.windows:
            window.render(data)
        return False

    def _done(self):
        self.refreshing = False
        return False

    def system_tick(self):
        if not self.config.get("show_system"):
            return True
        for window in self.windows:
            window.update_system()
        return True

    def minute_tick(self):
        interval = self.config.get("refresh_minutes") * 60
        if time.monotonic() - self._last_provider_fetch >= interval:
            self.trigger_refresh()
        return True

