#!/usr/bin/env python3
"""VigIA launcher — finds the app next to it (repo) or in ~/.local/share/vigia."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for candidate in (HERE, os.path.join(HERE, "..", "share", "vigia"),
                  os.path.expanduser("~/.local/share/vigia")):
    candidate = os.path.abspath(candidate)
    if os.path.isfile(os.path.join(candidate, "vigia_qt.py")):
        sys.path.insert(0, candidate)
        break

# A bundled libxcb-cursor (installed without root) must be visible before Qt loads.
BUNDLED_LIB = os.path.join(HERE, "lib")
if (not sys.platform.startswith("win") and os.path.isdir(BUNDLED_LIB)
        and BUNDLED_LIB not in os.environ.get("LD_LIBRARY_PATH", "")):
    os.environ["LD_LIBRARY_PATH"] = BUNDLED_LIB + (
        ":" + os.environ["LD_LIBRARY_PATH"] if os.environ.get("LD_LIBRARY_PATH") else "")
    os.execv(sys.executable, [sys.executable] + sys.argv)

try:
    from vigia_qt import main
except ImportError as error:
    sys.stderr.write(
        f"VigIA não conseguiu carregar o PySide6 ({error}).\n"
        "Rode ./install.sh (Linux) ou install.ps1 (Windows) para criar o ambiente.\n")
    raise SystemExit(1)

raise SystemExit(main())
